[TEMPLATE]
# Local development database (npm run db:start). Replace with your Neon connection string in production.
DATABASE_URL="postgresql://alu:alu@localhost:54329/alu_factory"
# Optional: Chrome/Edge path for server-side PDF rendering (auto-detected on Windows/macOS/Linux when unset)
# CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# Production (Railway + Neon): set DATABASE_URL on the Railway service to the Neon POOLED string
# (migrations derive the direct one automatically; see deploy/RAILWAY.md). CHROME_PATH=/usr/bin/chromium is set by railpack.json.
